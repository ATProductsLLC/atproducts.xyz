---
const { title, heroid, icon, color, bulletin, description, keywords, author, additionalContent, fourofour, apply } = Astro.props;

import "../styles/bootstrap.css";
import "bootstrap-icons/font/bootstrap-icons.css";
import bootstrap from "../scripts/bootstrap.bundle.js?url";

import jquery from "jquery/dist/jquery.min.js?url";
import jqueryui from "jquery-ui/dist/jquery-ui.min.js?url";

import { Font } from "astro:assets";

import '../styles/font.css';
import '../styles/other.css';
import '../styles/cookie.css';
---

<!DOCTYPE html>
<html class="fixedtopnavimage" lang="en">
  <head>
      <title>{title}</title> 
      <script src="/scripts/darkmode.js" is:inline></script>
      <script src="/scripts/navbar.js" is:inline></script>
      {heroid ?
        <Fragment>
        <link rel="preload" as="image" href={`/media/images/hero-${heroid}.webp`}>
        </Fragment>
        :
        <Fragment>
        <link rel="preload" as="image" href={`/media/images/hero.webp`}>
        </Fragment>
      }
      {bulletin && bulletin.map(({ bulletinImage }, index) => (
        bulletinImage ? (
            <link rel="preload" as="image" href={`/media/slideshow/${bulletinImage}`} />
        ) : null
      ))}
      {icon ?
        <Fragment>
          <link rel="icon" href={`/media/images/${icon}`}>
          <meta property="og:image" content={`/media/images/${icon}`}>
          <meta name="twitter:image" content={`/media/images/${icon}`}>
        </Fragment>
        :
        <Fragment>
          <link rel="shortcut icon" type="image/png" href="/media/favicon/favicon.png">
          <link rel="apple-touch-icon" sizes="180x180" href="/media/favicon/apple-touch-icon.png">
          <link rel="icon" type="image/png" href="/media/favicon/favicon.png">
          <link rel="icon" type="image/png" href="/media/favicon/android-chrome-192x192.png">
          <link rel="icon" type="image/png" sizes="32x32" href="/media/favicon/favicon-32x32.png">
          <link rel="icon" type="image/png" sizes="16x16" href="/media/favicon/favicon-16x16.png">
          <link rel="mask-icon" href="/media/favicon/safari-pinned-tab.svg" color="#5bbad5">
          <meta property="og:image" content="/media/favicon/iconembed.png">
          <meta name="twitter:image" content="/media/favicon/iconembed.png">
        </Fragment>
      }    
      <link rel="manifest" href="/media/favicon/site.webmanifest">
      <Font cssVariable="--font-body" preload/>
      <Font cssVariable="--font-title" preload/>
      <meta charset="UTF-8">
      <meta name="msapplication-TileColor" content="#da532c">
      <meta name="title" content={title}>
      <meta name="description" content={description}>
      <meta name="twitter:card" content="summary">
      <meta name="twitter:site" content="@ATProductsLLC">
      <meta name="twitter:creator" content="@ATProductsLLC">
      <meta name="twitter:title" content={title}>
      <meta name="twitter:description" content={description}>
      {keywords && (
        <meta name="keywords" content={keywords}>
      )}
      {author && (
        <meta name="author" content={author}>
      )}
      <meta property="og:title" content={title}>
      <meta property="og:description" content={description}>
      <meta property="og:site_name" content="AT Products LLC">
      {color ?
        <meta name="theme-color" content={color}>
        :
        <meta name="theme-color" content="#212529">
      }
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <meta http-equiv="X-UA-Compatible" content="IE=edge">
      <Fragment set:html={additionalContent} />
  </head>
  <body class="fixedtopnavimage">
    <Fragment>  
      <slot/>
    </Fragment>
    <Fragment>
      <script>
        import * as bootstrap from '../scripts/bootstrap.bundle.js';
        Object.assign(window, bootstrap);
        window.bootstrap = bootstrap;
        window.bootstrapReady?.();
      </script>

      <script src={jquery} is:inline></script>
      <script src={jqueryui} is:inline></script>
      <script src="/scripts/message.js" is:inline></script>
      <script src="/scripts/scroll.js" is:inline></script>
      <script src="/scripts/purecookie.js" is:inline></script>
      <script src="/scripts/alert-1.js" is:inline></script>
      <script src="/scripts/alert-2.js" is:inline></script>
      <script src="/scripts/enabler.js" is:inline></script>
      {apply && (
        <script src="/scripts/contact.js" is:inline></script>
      )}
      {fourofour && (
        <script src="/scripts/404.js" is:inline></script>
      )}
    </Fragment>
  </body>
</html>