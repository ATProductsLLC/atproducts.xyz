---
import DefaultBody from "../layouts/DefaultBody.astro";
import GamePage from "../layouts/GamePage.astro";
import GameList from "../layouts/GameList.astro";
---

<DefaultBody title="Pokemon Fire Red" emulator="true" description="Pokemon Fire Red is the third generation of the Pokemon RPG series, featuring new regions, characters, and gameplay elements." keywords="Pokemon, Fire Red, GBA, Nintendo, RPG, Pokemon Fire Red" author="AT Products LLC">
  <GamePage title="Pokemon Fire Red" emulator="true" emulatorsource="/games/pokemonfirered.gba">
    <GameList />
  </GamePage>
    <Fragment slot="emulator-script">
    <script type='text/javascript'>
    EJS_player = '#full-screen';
    // Can also be fceumm or nestopia
    EJS_core = 'gba';
    // Lightgun
    EJS_lightgun = false; // can be true or false
    // URL to BIOS file
    EJS_gameUrl = '/games/pokemonfirered.gba'; // https://dl.dropboxusercontent.com/s/[random-code]/Sonic.nes
    // Path to the data directory
    EJS_pathtodata = '/scripts/emulatorjs/data/';
</script>
  </Fragment>
</DefaultBody>