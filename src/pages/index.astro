        </div>
      </div>
      </div>

      <div class="ad-col ad-col-center">
        <div class="ad-card hide-phone">
        <span class="ad-label">Advertisement</span>
        <div class="ad-box" style="min-width:468px;min-height:60px;">
          <script is:inline>
            atOptions = {
              'key' : 'a0b7b4741d77243ea46684cb6b27675f',
              'format' : 'iframe',
              'height' : 60,
              'width' : 468,
              'params' : {}
            };
          </script>
          <script is:inline src="https://www.highrevenueformat.com/a0b7b4741d77243ea46684cb6b27675f/invoke.js"></script>
        </div>
      </div>
        <div class="ad-card ">
        <span class="ad-label">Advertisement</span>
        <div class="ad-box" style="min-width:300px;min-height:250px;">
          <script is:inline>
            atOptions = {
              'key' : '158bbd11ec1f205737043f4832348e20',
