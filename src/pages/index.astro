<Layout 
    title="RadiumOS" 
    description="RadiumOS is a 32-bit operating system written entirely from scratch by Pynx."
    keywords="radiumos, radium os, pynx, operating system, os, 32-bit, written from scratch"
    author="AT Products LLC & Pynx"
