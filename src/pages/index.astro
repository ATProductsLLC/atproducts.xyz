---
import DefaultBody from '../layouts/DefaultBody.astro';
import Hero   from '../components/Hero.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import Accordion from '../components/accordion/Accordion.astro';
import AccordionItem from '../components/accordion/AccordionItem.astro';
---

<DefaultBody title="AT Products LLC" description="AT Products LLC is an Informational Technology Company, with computer resources" keywords="AT Products, Ethical Hacking Society, The Script Community, AT Products LLC, ATproducts" author="Alex Toucan" 
additionalContent="<meta name='google-site-verification' content='8CRfwExNu3kB77SccZhzqhwnETsU2dnm0CACBJSRJ5M'>"
bulletin={[
  { bulletinImage: "5YEAR.webp" },
  { bulletinImage: "Versions.webp"},
  { bulletinImage: "v2252-081226-1.webp" },
  { bulletinImage: "v2252-081226-2.webp" },
  { bulletinImage: "v2252-081226-3.webp" },
]} 
index="true" accordion="true">
<div id="page">
  <Navbar />
  <div id="main-content">
    <Hero
      id="main"
      title="AT Products LLC"
      titleClasses="main-title"
      description="The company that provides <strong>web solutions</strong> to your <strong>web problems</strong>!"
      marginBottom="false"
      buttons={[
        { href: "/paid", text: "Paid Services", type: "primary" },
      ]},
      dropdownItems={[
        { navigationDesc: "Services We Provide", navigationLink: "#services" },
        { navigationDesc: "General Information", navigationLink: "#general-info" },
        { navigationDesc: "Products", navigationLink: "#products" },
        { navigationDesc: "Credits", navigationLink: "#credits" },
        { navigationDesc: "History", navigationLink: "#history" },
        { navigationDesc: "What's New?", navigationLink: "#what-new" },
      ]},
      icons={[
        { icon: "github", desc: "GitHub", href: "https://github.com/ATProductsLLC/atproducts.xyz" },
        { icon: "twitter-x", desc: "Twitter / X", href: "https://x.com/ATProductsLLC" },
        { icon: "instagram", desc: "Instagram", href: "https://www.instagram.com/atproductsllc/" },
        { icon: "youtube", desc: "YouTube", href: "https://youtube.com/c/AlexToucanAT" },
        { icon: "envelope-fill", desc: "Contact Form / Email", href: "/contact/" },
        { icon: "cloud-sun-fill", desc: "Weather", href: "https://x.com/ATPWeather" },
      ]},
    />
    <div id="carousel-A" class="carousel carousel-main carousel-fade container mt-6" data-bs-autoplay="true">
      <div class="carousel-inner rounded-5">
        <div class="carousel-item active" data-bs-interval="6000">
          <img src="/media/slideshow/5YEAR.webp" class="d-block w-100" alt="Happy 5 years of AT Products LLC!">
        </div>
        <div class="carousel-item" data-bs-interval="6000">
          <img src="/media/slideshow/Versions.webp" class="d-block w-100" alt="Versions Slide">
        </div>
        <div class="carousel-item" data-bs-interval="6000">
          <img src="/media/slideshow/v2252-081226-1.webp" class="d-block w-100" alt="v2.25.2 Release Slide 1">
        </div>
        <div class="carousel-item" data-bs-interval="6000">
          <img src="/media/slideshow/v2252-081226-2.webp" class="d-block w-100" alt="v2.25.2 Release Slide 2">
        </div>
        <div class="carousel-item" data-bs-interval="6000">
          <img src="/media/slideshow/v2252-081226-3.webp" class="d-block w-100" alt="v2.25.2 Release Slide 3">
        </div>
      </div>
      <div class="d-flex justify-content-between align-items-center">
        <div class="carousel-indicators">
          <button type="button" data-bs-target="#carousel-A" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
          <button type="button" data-bs-target="#carousel-A" data-bs-slide-to="1" aria-label="Slide 2"></button>
          <button type="button" data-bs-target="#carousel-A" data-bs-slide-to="2" aria-label="Slide 3"></button>
          <button type="button" data-bs-target="#carousel-A" data-bs-slide-to="3" aria-label="Slide 4"></button>
          <button type="button" data-bs-target="#carousel-A" data-bs-slide-to="4" aria-label="Slide 5"></button>
        </div>
        <div class="d-flex gap-1">
          <button class="btn-icon btn-sm carousel-control-play-pause" type="button" data-bs-target="#carousel-A" aria-label="Pause" data-bs-pause-label="Pause" data-bs-play-label="Play">
            <span class="carousel-icon-pause" aria-hidden="true"></span>
            <span class="carousel-icon-play" aria-hidden="true"></span>
          </button>
          <a href="/media/pdf/v2.25.2 Patch Notes.pdf" class="btn-icon btn-sm" target="_blank" rel="noopener noreferrer">
            <i class="bi bi-file-earmark-pdf-fill"></i>
            <span class="visually-hidden">PDF Download</span>
          </a>
          <button class="btn-icon btn-sm" type="button" data-bs-target="#carousel-A" data-bs-slide="prev">
            <span class="carousel-icon-prev" aria-hidden="true"></span>
            <span class="visually-hidden">Previous</span>
          </button>
