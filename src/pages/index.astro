  <!-- Bottom Buttons + Footer -->
  <div class="d-flex position-fixed bottom-0 mb-4 justify-content-between p-4 m-4 bottom-section rounded-6 bg-3">
    <div class="start-0" id="information-btn">
      <button class="btn-solid theme-secondary py-2 d-flex align-items-center shadow-lg"
              id="bd-information"
              type="button"
              data-bs-toggle="dialog"
              data-bs-target="#informationModal">
        <span><i class="my-1 bi bi-info"></i></span>
        <span class="visually-hidden" id="bd-information-text">Toggle information dialog</span>
      </button>
    </div>

    <footer class="text-center tab-link d-flex align-self-center">
      <span>2026 &reg; <a href="https://atproducts.xyz">AT Products LLC</a></span>
    </footer>

    <div class="end-0">
      <a class="d-block btn-solid theme-secondary" href="javascript:void(0)" role="button" data-bs-toggle="menu" data-bs-auto-close="outside" data-bs-placement="top-start" id="bd-theme">
        <span class="theme-icon-active"><i class="bi bi-sun-fill me-2 lg:me-0"></i></span>
        <i class="bi bi-sm bi-chevron-expand ms-1 lg:ms-2" aria-hidden="true"></i>
      </a>
      <div class="menu" data-bs-display="static" data-bs-popper="static">
        <a class="menu-item text-wrap-auto" href="javascript:void(0)" data-bs-theme-value="light">
          <i class="bi bi-sun-fill me-2"></i> Light
        </a>
        <a class="menu-item text-wrap-auto" href="javascript:void(0)" data-bs-theme-value="dark">
