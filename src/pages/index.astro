---
import DefaultBody from '../layouts/DefaultBody.astro';
---

<DefaultBody 
  title="Advertisements" 
  description="Support AT Products LLC with advertisements on our site." 
  keywords="advertisements, support, AT Products LLC" 
  author="AT Products LLC"
>
  <div class="container pt-6 pb-6">
    <h1 class="text-center fw-bolder">
      Advertisements from <a href="https://atproducts.xyz">AT Products LLC</a>
    </h1>

    <p class="text-center mt-4 mb-6 fw-semibold fs-md">
      Support us by viewing advertisements on this page—we keep our other sites ad-free for your convenience.
    </p>

    <!--
      Every script uses is:inline: Astro would otherwise bundle inline scripts as
      modules, which breaks the global atOptions the ad tags depend on.
      Layout is plain CSS (see the style block at the bottom of this file).
    -->

