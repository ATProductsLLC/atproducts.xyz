---
import DefaultBody from "../layouts/DefaultBody.astro";
import Navbar from "../components/Navbar.astro";
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const [featured, ...rest] = posts;

const hrefFor = (post) => post.data.path ?? `/blog/${post.id.replace(/\.md$/, "")}`;

const dateFmt = new Intl.DateTimeFormat("en-US", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });

import '../styles/blog.css';
---

<DefaultBody
  title="AT Products LLC: Blog"
  description="News, releases, and behind-the-scenes updates from AT Products LLC."
  author="Alex Toucan"
  keywords="AT Products LLC, blog, news, releases, ATP"
  color="#131415"
  breadcrumb="true"
>
  <Navbar />
  <div class="container py-5 blog-page">
    <div class="mb-5">
      <h1 class="display-5 fw-semibold mb-2">Blog</h1>
      <p class="text-body-secondary fs-5 mb-0">Releases, redesigns, and everything else we've been building.</p>
    </div>

    {featured && (
      <a href={hrefFor(featured)} class="text-decoration-none text-reset d-block mb-5">
        <div class="card bg-body-tertiary border-0 overflow-hidden rounded-8 featured-post">
          <div class="row g-0 align-items-stretch">
            <div class="md:col-6">
              <img src={featured.data.image} class="w-100 h-100 object-fit-cover" alt={featured.data.title} loading="eager" style="min-height: 320px;">
            </div>
            <div class="md:col-6">
              <div class="card-body h-100 d-flex flex-column p-4 lg:p-5 rounded-top-0 rounded-bottom-8">
                <span class="badge text-bg-primary align-self-start mb-3 fw-medium">Latest</span>
                <h2 class="card-title fw-semibold mb-3">{featured.data.title}</h2>
                <p class="card-text text-body-secondary mb-4">{featured.data.excerpt ?? featured.data.description}</p>
                <div class="mt-auto d-flex align-items-center gap-2">
                  {featured.data.author.map((a) => (
                    <img src={a.image} alt={a.name} class="rounded-circle author-avatar" width="32" height="32">
                  ))}
                  <span class="fw-medium">{featured.data.author.map((a) => a.name).join(", ")}</span>
                  <span class="text-body-secondary">&middot;</span>
                  <time datetime={featured.data.date.toISOString()} class="text-body-secondary">{dateFmt.format(featured.data.date)}</time>
                </div>
              </div>
            </div>
          </div>
        </div>
      </a>
    )}

    {rest.length > 0 && (
      <div class="row row-cols-1 sm:row-cols-2 lg:row-cols-3 g-4">
        {rest.map((post) => (
          <div class="col">
            <div class="card h-100 bg-body-tertiary border-0 rounded-8 position-relative post-card">
              <div class="ratio ratio-16x9">
                <img src={post.data.image} class="w-100 h-100 object-fit-cover" alt={post.data.title} loading="lazy">
              </div>
              <div class="card-body d-flex flex-column rounded-top-0 rounded-bottom-8">
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="mb-2 d-flex flex-wrap gap-1">
                    {post.data.tags.map((tag) => (
                      <span class="badge text-bg-secondary fw-medium">{tag}</span>
                    ))}
                  </div>
                )}
                <h3 class="card-title h5 fw-semibold mb-2">
                  <a href={hrefFor(post)} class="text-reset text-decoration-none stretched-link">{post.data.title}</a>
                </h3>
                <p class="card-text text-body-secondary small mb-3">{post.data.excerpt ?? post.data.description}</p>
                <div class="mt-auto d-flex align-items-center gap-2 small">
                  {post.data.author.slice(0, 1).map((a) => (
                    <img src={a.image} alt={a.name} class="rounded-circle author-avatar" width="24" height="24">
                  ))}
                  <span class="fw-medium">{post.data.author.map((a) => a.name).join(", ")}</span>
                  <span class="text-body-secondary">&middot;</span>
                  <time datetime={post.data.date.toISOString()} class="text-body-secondary">{dateFmt.format(post.data.date)}</time>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    )}

    {posts.length === 0 && (
      <div class="text-center text-body-secondary py-5">
        <p class="fs-5 mb-0">No posts yet — check back soon.</p>
      </div>
    )}
  </div>
</DefaultBody>

<style>
  .featured-post {
    transition: transform 0.15s ease;
  }
  .featured-post:hover {
    transform: translateY(-2px);
  }
  .post-card {
    overflow: hidden;
    transition: transform 0.15s ease;
  }
  .post-card:hover {
    transform: translateY(-2px);
  }
  .author-avatar {
    object-fit: cover;
  }
</style>