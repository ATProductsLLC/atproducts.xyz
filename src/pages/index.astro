      <div class="ad-card only-desktop">
        <span class="ad-label">Advertisement</span>
        <div class="ad-box" style="min-width:728px;min-height:90px;">
          <script is:inline>
            atOptions = {
              'key' : '1b091bc2c6b88afcf4bea9782acbc1b4',
              'format' : 'iframe',
              'height' : 90,
              'width' : 728,
              'params' : {}
            };
          </script>
          <script is:inline src="https://www.highrevenueformat.com/1b091bc2c6b88afcf4bea9782acbc1b4/invoke.js"></script>
        </div>
      </div>
      <div class="ad-card only-mobile">
        <span class="ad-label">Advertisement</span>
        <div class="ad-box" style="min-width:320px;min-height:50px;">
          <script is:inline>
            atOptions = {
              'key' : 'a46fa7a655ee1b120a82fc6e9d30b1f9',
              'format' : 'iframe',
              'height' : 50,
              'width' : 320,
              'params' : {}
            };
          </script>
          <script is:inline src="https://www.highrevenueformat.com/a46fa7a655ee1b120a82fc6e9d30b1f9/invoke.js"></script>
        </div>
      </div>
    </div>

    <!-- MAIN GRID: [skyscraper] [center stack] [skyscraper] -->
