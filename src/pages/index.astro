          </div>
          <div class="col" data-reveal>
            <article class="card h-100 hover-lift">
              <div class="card-body d-flex flex-column p-6">
                <span class="avatar avatar-lg theme-primary mb-5">
                  <i class="bi bi-cloud-check fs-2xl" aria-hidden="true">
                  </i>
                </span>
