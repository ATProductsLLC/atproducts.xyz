<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For Abigail</title>
<meta name="description" content="A page to appreciate Abigail.">
<meta name="theme-color" content="#3a2b4d">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Work+Sans:wght@400;500&display=swap" rel="stylesheet">
<link rel="shortcut icon" type="image/png" href="/media/favicon/iconembed.png">
<link rel="icon" type="image/png" href="/media/favicon/iconembed.png">
<meta property="og:title" content="For Abigail 🌸">
<meta property="og:image" content="https://abigail.atproducts.xyz/media/favicon/iconembed.png">
<meta name="theme-color" content="#ff3a76">
<meta name="msapplication-TileColor" content="#da532c">
<link rel="manifest" href="/media/favicon/site.webmanifest">
<style>
  :root{
    --plum:#3557a0;
    --plum-deep:#141c33;
    --gold:#e8879f;
    --blush:#f6c9d6;
    --paper:#faf7f5;
    --ink:#26232b;
    --line: rgba(255,255,255,0.14);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--paper);
    color:var(--ink);
    font-family:'Work Sans', sans-serif;
    font-size:17px;
    line-height:1.6;
  }
  h1,h2,h3,.display{
    font-family:'Fraunces', serif;
    font-weight:500;
    letter-spacing:-0.01em;
  }
  a{color:inherit;}

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    min-height:88vh;
    background:radial-gradient(120% 140% at 20% 0%, var(--plum) 0%, var(--plum-deep) 60%, #0a0e1c 100%);
    color:#f4ece2;
    display:flex;
    align-items:center;
    overflow:hidden;
  }
  .hero-inner{
    position:relative;
    z-index:2;
    max-width:720px;
    margin:0 auto;
    padding:6rem 1.5rem;
    text-align:center;
  }
  .hero-eyebrow{
    font-size:0.95rem;
    color:var(--gold);
    margin-bottom:1.25rem;
    opacity:0;
    animation:rise .8s ease forwards .15s;
  }
  .hero h1{
    font-size:clamp(2.8rem, 8vw, 5.2rem);
    line-height:1.02;
    margin:0 0 1.25rem;
    opacity:0;
    animation:rise .9s ease forwards .35s;
  }
  .hero p{
    font-size:1.15rem;
    color:#d9cbe0;
    max-width:520px;
    margin:0 auto;
    opacity:0;
    animation:rise .9s ease forwards .6s;
  }
  @keyframes rise{
    from{opacity:0; transform:translateY(14px);}
    to{opacity:1; transform:translateY(0);}
  }
  .drift{position:absolute; border-radius:50%; filter:blur(2px); opacity:.5; pointer-events:none;}
  .drift.a{width:10px;height:10px;background:var(--gold);top:18%;left:12%;animation:float 9s ease-in-out infinite;}
  .drift.b{width:6px;height:6px;background:var(--blush);top:65%;left:80%;animation:float 11s ease-in-out infinite 1s;}
  .drift.c{width:14px;height:14px;background:var(--gold);top:75%;left:22%;animation:float 13s ease-in-out infinite .5s;opacity:.3;}
  .drift.d{width:8px;height:8px;background:var(--blush);top:30%;left:85%;animation:float 10s ease-in-out infinite 2s;}
  @keyframes float{
    0%,100%{transform:translateY(0) translateX(0);}
    50%{transform:translateY(-26px) translateX(10px);}
  }

  .avatar{
    width:132px;
    height:132px;
    border-radius:50%;
    margin:0 auto 1.75rem;
    background:linear-gradient(160deg, var(--blush), var(--gold));
    border:2px solid rgba(244,236,226,0.35);
    display:flex;
    align-items:center;
    justify-content:center;
    font-family:'Fraunces', serif;
    font-size:2.4rem;
    color:var(--plum-deep);
    opacity:0;
    animation:rise .9s ease forwards 0s;
    box-shadow:0 10px 30px rgba(0,0,0,0.25);
    object-fit:cover;
  }

  /* ---------- SECTIONS ---------- */
  section{padding:5rem 1.5rem;}
  .wrap{max-width:760px; margin:0 auto;}
  .kicker{
    color:var(--gold);
    font-size:0.9rem;
    margin-bottom:0.5rem;
  }
  section h2{font-size:clamp(1.8rem, 4vw, 2.4rem); margin:0 0 1.75rem;}

  /* reasons */
  .reasons-box{
    background:#fff;
    border:1px solid #ece2d6;
    border-radius:6px;
    padding:2.5rem;
    text-align:center;
  }
  #reasonText{
    font-family:'Fraunces', serif;
    font-size:1.4rem;
    min-height:3.2em;
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--plum);
  }
  button.btn-line{
    margin-top:1.25rem;
    background:none;
    border:1px solid var(--plum);
    color:var(--plum);
    padding:0.7rem 1.6rem;
    border-radius:3px;
    font-family:'Work Sans', sans-serif;
    font-size:0.95rem;
    cursor:pointer;
    transition:background .2s ease, color .2s ease;
  }
  button.btn-line:hover{background:var(--plum); color:#fff;}

  /* timeline */
  .timeline{border-left:2px solid #e4d8c9; padding-left:1.75rem; margin-left:0.25rem;}
  .t-item{position:relative; padding-bottom:2.25rem;}
  .t-item:last-child{padding-bottom:0;}
  .t-item::before{
    content:'';
    position:absolute; left:-2.35rem; top:0.35rem;
    width:11px; height:11px; border-radius:50%;
    background:var(--gold);
    box-shadow:0 0 0 4px #faf7f5;
  }
  .t-date{font-size:0.85rem; color:#9a8a72; letter-spacing:0.02em;}
  .t-title{font-family:'Fraunces', serif; font-size:1.2rem; margin:0.15rem 0 0.2rem;}

  /* traits grid */
  .traits{display:grid; grid-template-columns:1fr 1fr; gap:1px; background:#e4d8c9; border:1px solid #e4d8c9;}
  .trait{background:var(--paper); padding:1.9rem;}
  .trait h3{font-size:1.05rem; margin:0 0 0.5rem; font-family:'Work Sans',sans-serif; font-weight:500;}
  .trait p{margin:0; font-size:0.96rem; color:#5b5062;}
  @media (max-width:560px){.traits{grid-template-columns:1fr;}}

  /* gallery */
  .gallery{display:grid; grid-template-columns:repeat(3,1fr); gap:0.5rem;}
  .frame{
    aspect-ratio:4/5;
    width:100%;
    min-width:90px;
    max-width:260px;
    min-height:115px;
    max-height:325px;
    border-radius:4px;
    background:linear-gradient(160deg, var(--blush), var(--plum));
    display:flex; align-items:center; justify-content:center;
    color:rgba(255,255,255,.75);
    font-size:0.8rem;
    text-align:center;
    object-fit:cover;
  }
  @media (max-width:560px){.gallery{grid-template-columns:repeat(2,1fr);}}

  /* quote */
  .quote{
    background:var(--plum-deep);
    color:#f4ece2;
  }
  .quote blockquote{
    font-family:'Fraunces', serif;
    font-size:clamp(1.4rem, 3.4vw, 1.9rem);
    font-style:italic;
    text-align:center;
    max-width:640px;
    margin:0 auto;
    line-height:1.45;
  }
  .quote cite{
    display:block;
    text-align:center;
    margin-top:1.25rem;
    font-style:normal;
    color:var(--gold);
    font-size:0.95rem;
  }

  footer{
    text-align:center;
    padding:3rem 1.5rem 4rem;
    color:#9a8a72;
    font-size:0.9rem;
  }

  /* notes accordion */
  .note{
    border:1px solid #ece2d6;
    border-radius:6px;
    margin-bottom:0.75rem;
    background:#fff;
    overflow:hidden;
  }
  .note-head{
    width:100%;
    text-align:left;
    background:none;
    border:none;
    padding:1.1rem 1.4rem;
    font-family:'Fraunces', serif;
    font-size:1.05rem;
    color:var(--plum);
    cursor:pointer;
    display:flex;
    justify-content:space-between;
    align-items:center;
    gap:1rem;
  }
  .note-head .mark{color:var(--gold); font-family:'Work Sans',sans-serif; font-size:1.2rem; transition:transform .2s ease;}
  .note-head[aria-expanded="true"] .mark{transform:rotate(45deg);}
  .note-body{
    max-height:0;
    overflow:hidden;
    transition:max-height .25s ease;
    padding:0 1.4rem;
  }
  .note-body p{margin:0 0 1.1rem; color:#5b5062; font-size:0.96rem;}

  /* playlist */
  .playlist{border-top:1px solid #ece2d6;}
  .track{
    display:flex;
    flex-wrap:wrap;
    align-items:center;
    gap:0.85rem;
    padding:1rem 0.25rem;
    border-bottom:1px solid #ece2d6;
  }
  .track-num{
    font-family:'Fraunces', serif;
    color:var(--gold);
    width:1.6rem;
    font-size:1rem;
  }
  .track-cover{
    width:52px;
    height:52px;
    border-radius:4px;
    flex-shrink:0;
    background:linear-gradient(160deg, var(--blush), var(--plum));
    display:flex;
    align-items:center;
    justify-content:center;
    color:rgba(255,255,255,.8);
    font-size:0.65rem;
    text-align:center;
    line-height:1.2;
    object-fit: cover;
  }
  .track-info{flex:1; min-width:120px;}
  .track-title{font-size:0.98rem; color:var(--ink);}
  .track-artist{font-size:0.85rem; color:#9a8a72;}
  .track-why{font-size:0.85rem; color:#9a8a72; max-width:220px; text-align:right;}
  .track-links{
    display:flex;
    gap:0.5rem;
    flex-shrink:0;
  }
  .track-links a{
    display:flex;
    align-items:center;
    justify-content:center;
    width:22px;
    height:22px;
    transition:transform .15s ease, opacity .15s ease;
    opacity:0.85;
  }
  .track-links a:hover{opacity:1; transform:translateY(-1px);}
  .track-links svg{width:19px; height:19px;}

  @media (max-width:560px){
    .track-why{
      max-width:none;
      width:100%;
      text-align:center;
      order:5;
      margin-left:calc(52px + 0.85rem);
      margin-top:-0.35rem;
    }
    .track-links{order:4;}
  }

  /* what's next */
  .next-list{list-style:none; margin:0; padding:0;}
  .next-list li{
    display:flex;
    gap:1rem;
    align-items:flex-start;
    padding:1rem 0;
    border-bottom:1px solid #ece2d6;
  }
  .next-list li:last-child{border-bottom:none;}
  .next-check{
    width:20px; height:20px;
    border-radius:50%;
    border:2px solid var(--plum);
    flex-shrink:0;
    margin-top:0.15rem;
  }
  .next-text strong{font-family:'Fraunces', serif; font-weight:500; display:block; margin-bottom:0.15rem;}
  .next-text span{font-size:0.9rem; color:#5b5062;}

  /* tiktok embed wrapper */
  .tiktok-wrap{margin-top:1rem;}
  .tiktok-wrap blockquote.tiktok-embed{margin:0;}
</style>
</head>
<body>

<section class="hero">
  <span class="drift a"></span><span class="drift b"></span><span class="drift c"></span><span class="drift d"></span>
