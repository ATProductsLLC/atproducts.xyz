        <div class="ad-card ">
        <span class="ad-label">Advertisement</span>
        <div class="ad-box" style="min-width:160px;min-height:600px;">
          <script is:inline>
            atOptions = {
              'key' : 'f803b11794063cf668fc3ee91f60b82a',
              'format' : 'iframe',
