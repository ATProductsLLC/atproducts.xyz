  <!-- Dialog (Bootstrap 6: native <dialog>, no .modal-dialog/.modal-content wrappers) -->
  <dialog class="dialog" id="informationModal" aria-labelledby="informationModalLabel">
    <div class="dialog-header">
      <h1 class="dialog-title fs-lg" id="informationModalLabel">Information & Credits</h1>
      <button type="button" class="btn-close" data-bs-dismiss="dialog" aria-label="Close">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" width="20" height="20" fill="none">
          <path fill="currentcolor" d="M12 0a4 4 0 0 1 4 4v8a4 4 0 0 1-4 4H4a4 4 0 0 1-4-4V4a4 4 0 0 1 4-4zm-.646 4.646a.5.5 0 0 0-.707 0L8 7.293 5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.647a.5.5 0 1 0 .708.707L8 8.707l2.647 2.646a.5.5 0 1 0 .707-.707L8.707 8l2.646-2.646a.5.5 0 0 0 0-.708z"/>
        </svg>
      </button>
    </div>

    <div class="dialog-body">
      <div class="hero hero-main md:p-6 rounded-2 mb-4">
        <div class="credit-card p-2 rounded-6 d-grid mx-auto" style="width: 217px; filter: drop-shadow(2px 4px 6px black);">
          <span class="credit-title text-center fw-bold fs-xl mb-2">Made by:</span>
          <a class="btn-solid theme-dark py-2" href="https://atproducts.xyz" target="_blank" rel="noopener noreferrer">
            <img alt="AT Products LLC" src="https://atproducts.xyz/media/images/longwhite.png" width="175px">
          </a>
        </div>
      </div>

      <h2>Information</h2>
      <div class="text-justify">
        <p class="tab">
          This page is dedicated to supporting <a href="https://atproducts.xyz"><strong>AT Products LLC</strong></a> through advertisements.
        </p>
        <p class="tab">
          Your support directly contributes to the maintenance and development of our platforms.
        </p>
        <p class="tab">
          If you wish to support us further, please consider visiting our <a href="https://atproducts.xyz/paid">Paid Products</a>.
        </p>
      </div>
    </div>

    <div class="dialog-footer">
      <button type="button" class="btn-solid theme-secondary" data-bs-dismiss="dialog">Close</button>
    </div>
  </dialog>

</DefaultBody>

<style>
  /* ---------- Card ---------- */
  .ad-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    width: fit-content;
    max-width: 100%;
    padding: 0.6rem 0.75rem 0.75rem;
    border: 1px solid rgba(128, 128, 128, 0.28);
    border-radius: 0.6rem;
    background: rgba(128, 128, 128, 0.07);
  }
  .ad-label {
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.55;
  }
  /* Reserves the unit's size so nothing jumps while ads load */
  .ad-box { max-width: 100%; overflow: hidden; }
  .ad-card-native { width: 100%; }
  .ad-card-native > div { width: 100%; }

  /* ---------- Top banner ---------- */
  .ad-top {
    display: flex;
    justify-content: center;
    margin-bottom: 1.5rem;
  }

  /* ---------- Main grid (mobile first) ---------- */
  .ad-layout {
    display: grid;
    grid-template-columns: repeat(2, auto);
    justify-content: center;
    align-items: start;
    gap: 1.5rem 1rem;
    max-width: 1100px;
    margin: 0 auto;
  }
  .ad-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    min-width: 0;
  }
  .ad-col-center { grid-column: 1 / -1; order: -1; width: 100%; }

  /* ---------- Visibility by screen size ---------- */
  .only-desktop { display: none; }
  @media (max-width: 575.98px) { .hide-phone { display: none; } }

  /* ---------- Desktop: three columns ---------- */
  @media (min-width: 992px) {
    .only-desktop { display: flex; }
    .only-mobile { display: none; }
    .ad-layout {
      grid-template-columns: 200px minmax(0, 1fr) 200px;
      gap: 1.5rem;
    }
    .ad-col-center { grid-column: auto; order: 0; width: auto; }
  }

  /* ---------- Credits badge in the dialog ---------- */
  .credit-card { background-color: #212529; }
  .credit-title { color: #fff; }

  /* ---------- Closed dialog must not add page height ---------- */
  /* Bootstrap 6's .dialog sets display:flex, which overrides the browser's
     "closed dialog = display:none". The closed dialog then sits in the page as an
     invisible absolutely-positioned box and stretches the scroll height.
     Fixed positioning takes it out of the scrollable area; open dialogs are
     unaffected (they render in the top layer). */
  .dialog:not([open]) { position: fixed; }
</style>