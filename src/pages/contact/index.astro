---
import DefaultBody from '../../layouts/DefaultBody.astro';
import Navbar    from '../../components/Navbar.astro';
import Footer    from '../../components/Footer.astro';
import BackToTop from '../../components/BackToTop.astro';

import '../../styles/imagesizes.css'
import '../../styles/contact.css'
---

<DefaultBody title="Contact Form" description="If you don't want to email us on your email client, use this instead. We'll reach out to your email provided." author="Alex Toucan" contact>
<div id="page">
  <Navbar />
  <div id="main-content">
    <main id="form" class="container">
      <h1 class="title">Contact Form</h1>
      <p>You may either use this Contact Form, or <a href="mailto:support@atproducts.xyz">email us manually</a>. You can use this instead if you do not wish to email us from your email client. We will make sure to reach out to the email address provided. <strong>Reminder, submitting this form sends us the information you provide, plus additional data.</strong> For details on how submissions are handled, please view the <a href="/privacy#ip">Privacy Policy</a> for more information.</p>
      <form
        name="Contact Form" 
        action="/contact/success"
        method="POST"
        data-netlify="true"
        enctype="multipart/form-data"
        data-netlify-honeypot="bot-field"
      >
        <input type="hidden" name="form-name" value="Contact Form">
        <input type="hidden" name="bot-field">

        <div class="d-sm-flex gap-2">
          <div class="col">
            <div class="form-floating mb-3">
              <label for="nameInput" class="form-label fw-normal">Name</label>
              <input name="name" class="form-control" id="nameInput" placeholder="John Doe" required>
          </div>
          </div>
          <div class="col">
            <div class="form-floating mb-3">
              <label for="emailInput" class="form-label fw-normal">Email address</label>
              <input name="Email" type="email" class="form-control" id="emailInput" placeholder="name@example.com" required>
            </div>
          </div>
        </div>
        <div class="form-floating mb-3">
          <label for="textareaInput" class="form-label fw-normal">Information to Send</label>
          <textarea name="Text" class="form-control info-box" id="textareaInput" placeholder="Input comments or information to send" required></textarea>
        </div>
        <div class="my-2">
          <label 
            for="attachment" 
            id="attachment-label"
            tabindex="0"
            class="form-control file-box d-flex justify-content-between align-items-center small"
          >
            <span class="fw-normal">Attach a File (optional)</span>
            <span id="attachment-filename" class="text-end text-break">Select a File</span>
          </label>
          <div id="attachment-feedback" class="invalid-feedback d-none">
            File must be 10MB or smaller.
          </div>
          <input 
            type="file" 
            id="attachment" 
            name="file" 
            class="d-none"
            accept="image/*,video/*,audio/*"
          >
        </div>
        <small>If you wish to include more than one file, you must <a href="mailto:support@atproducts.xyz">email us manually</a> due to Netlify complications. Please allow 72 hours for a response back to your email provided. If your response is considered spam, it may not be responded to.</small>
        <button type="submit" class="mt-2 btn btn-lg btn-solid theme-primary col-12">Send</button>
      </form>
    </main>
  <Footer />
  </div>
<BackToTop />
</div>
</DefaultBody>
