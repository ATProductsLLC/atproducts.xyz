---
const { pageTitle } = Astro.props;
---

<a href="#main-content" class="visually-hidden-focusable btn-solid theme-primary position-fixed m-2 hero-filter skip-content" title="Skip to main content">Skip to main content</a>

<header class="main-navbar fixed-top">
  <nav class="navbar lg:navbar-expand fg-2">
    <div class="container-fluid">
      <a href="https://atproducts.xyz" aria-label="Return to AT Products LLC" class="theme-inverse md:d-block border-0 p-0 lg:me-2 fs-2xl align-self-center">
        <i class="bi bi-arrow-left-short"></i>
      </a>
      <a class="navbar-brand" href="/">
        <img src="/media/images/DoBT-Logo-Black.webp" height="45px" alt="AT Products LLC - Department of Beta Testing" class="headerimg">
      </a>
      <button class="btn-icon navbar-toggler" type="button" data-bs-toggle="drawer" data-bs-target="#navbarLeftDrawer" aria-controls="navbarLeftDrawer" aria-expanded="false" aria-label="Toggle navigation">
        <svg class="navbar-toggler-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round"><path d="M1 3.5h14M1 8h14M1 12.5h14"/></svg>
      </button>
      <dialog class="drawer drawer-start" tabindex="-1" id="navbarLeftDrawer" aria-labelledby="navbarLeftDrawerLabel">
        <div class="drawer-header">
          <h5 class="drawer-title" id="navbarLeftDrawerLabel">
            <img src="/media/images/DoBT-Logo-Black.webp" height="45px" alt="AT Products LLC - Department of Beta Testing" class="headerimg">
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="drawer" aria-label="Close"></button>
        </div>
        <div class="drawer-body">
          <ul class="navbar-nav me-auto mb-2 md:mb-0">
            <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
            <li class="nav-item"><a class="nav-link" href="/apply">Apply</a></li>
            <li class="nav-item"><a class="nav-link" href="/links">Links</a></li>
            <li class="nav-item"><a class="nav-link" href="/guidelines">Guidelines</a></li>
          </ul>
          <div class="d-flex lg:flex-row flex-column gap-4 mt-auto">
            <a class="btn btn-solid theme-primary fw-medium mx-2 lg:mx-0" href="/apply">Apply Today!</a>
            <div class="navbar-nav justify-content-start lg:ms-auto nav-tab-link lg:mt-0 mb-0 lg:align-self-center">
              <div class="p-0">
                <a class="dropdown-toggle nav-link d-block" href="javascript:void(0)" role="button" data-bs-toggle="menu" data-bs-auto-close="outside" data-bs-placement="top-start" id="bd-theme">
                  <span class="theme-icon-active"><i class="bi bi-sun-fill me-2 lg:me-0"></i></span>
                  <span class="lg:d-none" id="bd-theme-text">Change theme</span>
                  <i class="bi bi-sm bi-chevron-expand ms-1 lg:ms-2" aria-hidden="true"></i>
                </a>
                <div class="menu" data-bs-display="static" data-bs-popper="static">
                  <a class="menu-item text-wrap-auto" href="javascript:void(0)" data-bs-theme-value="light">
                    <i class="bi bi-sun-fill me-2"></i> Light
                  </a>
                  <a class="menu-item text-wrap-auto" href="javascript:void(0)" data-bs-theme-value="dark">
                    <i class="bi bi-moon-stars-fill me-2"></i> Dark
                  </a>
                  <a class="menu-item text-wrap-auto" href="javascript:void(0)" data-bs-theme-value="auto">
                    <i class="bi bi-circle-half me-2"></i> Auto
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      </dialog>
    </div>
  </nav>
</header>

<noscript>
  <div class="alert alert-dark mb-0" role="alert">
    <strong>It seems like you don't have JavaScript enabled!</strong> You will need JavaScript for color modes, accordions, scrollspies, tab panes, dropdowns, popovers, and more! We do not have fallbacks, so please enable JavaScript or <a href="https://github.com/Alex-Toucan/atproducts.xyz">view the source code to read the information</a>.
  </div>
</noscript>