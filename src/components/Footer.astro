---
const { author, hr, marginTop } = Astro.props;
---

<footer>
  {hr !== 'none' && <hr>}
  <div class={`container-footer ${marginTop === 'true' ? 'lg:mt-0 mt-3' : ''}`}>
    <div class="lg:mt-8">
      <div class="row lg:px-2">
        <div class="lg:col-2 xesm:me-2">
         <div class="text-center">
           <div class="imgdiv"><a href="/"><img src="/media/images/DoBT-Short-Logo-Black.webp" width="50%" alt="icon" class="footerimg"></a></div>
             <br>
             <h1 class="footer-header"><a href="/">AT Products LLC</a></h1>
             <h5><a href="/" class="fg-secondary fs-wm">Department of Beta Testing</a></h5>
          </div>
        </div>
        <div class="lg:col-2 lg:mt-0 mt-2 lg:me-2 lg:text-centertostart">
          <h2 class="footer-header">DoBT Links</h2>
          <ul class="nav flex-column">
            <li class="nav-item mb-2 d-block lg:d-flex mx-3 mx-xsm-5 lg:mx-0"><a href="/" class="nav-link p-0 text-normal">Home</a></li>
            <li class="nav-item mb-2 d-block lg:d-flex mx-3 mx-xsm-5 lg:mx-0"><a href="/apply" class="nav-link p-0 text-wrap-auto">Apply</a></li>
            <li class="nav-item mb-2 d-block lg:d-flex mx-3 mx-xsm-5 lg:mx-0"><a href="/links" class="nav-link p-0 text-wrap-auto">Links</a></li>
            <li class="nav-item mb-2 d-block lg:d-flex mx-3 mx-xsm-5 lg:mx-0"><a href="/guidelines" class="nav-link p-0 text-wrap-auto">Guidelines</a></li>
          </ul>
        </div>
        <div class="lg:col-2 lg:mt-0 mt-2 lg:me-2 lg:text-centertostart">
          <h2 class="footer-header">ATPLLC Links</h2>
          <ul class="nav flex-column">
            <li class="nav-item mb-2 d-block lg:d-flex mx-3 mx-xsm-5 lg:mx-0"><a href="https://atproducts.xyz" class="nav-link p-0 text-wrap-auto">Department of Beta Testing</a></li>
            <li class="nav-item mb-2 d-block lg:d-flex mx-3 mx-xsm-5 lg:mx-0"><a href="https://beta.atproducts.xyz" class="nav-link p-0 text-wrap-auto">The Toucan Empire</a></li>
            <li class="nav-item mb-2 d-block lg:d-flex mx-3 mx-xsm-5 lg:mx-0"><a href="https://portfolio.atproducts.xyz/#toucanempire" class="nav-link p-0 text-wrap-auto">The Toucan Empire</a></li>
            <li class="nav-item mb-2 d-block lg:d-flex mx-3 mx-xsm-5 lg:mx-0"><a href="https://portfolio.atproducts.xyz/#atpweather" class="nav-link p-0 text-wrap-auto">ATPWeather</a></li>
            <li class="nav-item mb-2 d-block lg:d-flex mx-3 mx-xsm-5 lg:mx-0"><a href="https://backup.atproducts.xyz/" class="nav-link p-0 text-wrap-auto">Public Archive</a></li>
          </ul>
        </div>
        <div class="lg:col-2 lg:mt-0 mt-2 lg:me-2 lg:text-centertostart">
          <h2 class="footer-header">Documentation</h2>
          <ul class="nav flex-column">
            <li class="nav-item mb-2 d-block lg:d-flex mx-3 mx-xsm-5 lg:mx-0"><a href="/guidelines" class="nav-link p-0 text-normal">DoBT Guidelines</a></li>
            <li class="nav-item mb-2 d-block lg:d-flex mx-3 mx-xsm-5 lg:mx-0"><a href="/terms" class="nav-link p-0 text-normal">Terms of Service</a></li>
            <li class="nav-item mb-2 d-block lg:d-flex mx-3 mx-xsm-5 lg:mx-0"><a href="/discord" class="nav-link p-0 text-wrap-auto">Discord Rules</a></li>
            <li class="nav-item mb-2 d-block lg:d-flex mx-3 mx-xsm-5 lg:mx-0"><a href="/policies" class="nav-link p-0 text-wrap-auto">Policies</a></li>
            <li class="nav-item mb-2 d-block lg:d-flex mx-3 mx-xsm-5 lg:mx-0"><a href="/licenses" class="nav-link p-0 text-wrap-auto">Licenses</a></li>
          </ul>
        </div>
      </div>
      <div class="d-flex justify-content-between pt-3 pb-2 mt-4 border-top">
        <div class="lg:d-flex">
          <a class="ms-4 footer-info dropdown-toggle" data-bs-toggle="collapse" data-bs-target="#footerinfo" role="button" aria-expanded="false" aria-controls="footerinfo">
            Information
            <i class="ms-2 bi bi-sm bi-chevron-expand" aria-hidden="true"></i>
          </a>
          <div class="ms-4 pt-2 lg:col-6 collapse" id="footerinfo">
            <div class="card card-body text-start d-block lg:d-flex">
              <b>Version:</b> <script is:inline src="/scripts/version.js"></script><br>
              {author ?
                <>
                  <b>Author:</b> {author}
                </>
                :
                <>
                 <b>Author:</b> Alex Toucan
                </>
              }    
              <br><br>
              <p>&copy; {new Date().getFullYear()} AT Products LLC</p>
             </div>
            </div>
          </div>
          <ul class="list-unstyled d-flex me-4 gap-4">
            <li><a class="link-footer" href="https://github.com/Alex-Toucan/atproducts.xyz" aria-label="GitHub"><i class="bi bi-github"></i></a></li>
            <li><a class="link-footer" href="https://x.com/ATProductsLLC" aria-label="Twitter / X"><i class="bi bi-twitter-x"></i></a></li>
            <li><a class="link-footer" href="https://www.instagram.com/atproductsllc/" aria-label="Instagram"><i class="bi bi-instagram"></i></a></li>
            <li><a class="link-footer" href="https://youtube.com/c/AlexToucanAT" aria-label="YouTube"><i class="bi bi-youtube"></i></a></li>
            <li><a class="link-footer" href="/contact/" aria-label="Contact Form / Email"><i class="bi bi-envelope-fill"></i></a></li>
            <li><a class="link-footer" href="https://x.com/ATPWeather" aria-label="Weather"><i class="bi bi-cloud-sun-fill"></i></a></li>
          </ul>
        </div>
      </div>
    </div>
</footer>